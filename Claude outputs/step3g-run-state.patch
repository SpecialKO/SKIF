diff -ru skif.orig/src/stores/Steam/app_record.cpp skif/src/stores/Steam/app_record.cpp
--- skif.orig/src/stores/Steam/app_record.cpp	2026-10-24 00:35:14.274372882 +0000
+++ skif/src/stores/Steam/app_record.cpp	2026-10-24 00:36:40.435993485 +0000
@@ -833,3 +833,26 @@
 }
 
 #pragma endregion
+
+#pragma region Run State
+
+// Epic, GOG and SKIF Custom should be straight forward: match the full path of the primary launch config
+app_record_s::ProcessMatch
+app_record_s::MatchProcess (const wchar_t* wszExeFile, const wchar_t* wszExePath, DWORD dwExePathLen)
+{
+  UNREFERENCED_PARAMETER (wszExeFile);
+
+  if (dwExePathLen != 0 && _wcsnicmp (launch_configs[0].getExecutableFullPath ( ).c_str(), wszExePath, dwExePathLen) == 0) // full path
+    return ProcessMatch::Running;
+
+  // One can also perform a partial match with the below OR clause in the IF statement, however from testing
+  //   PROCESS_QUERY_LIMITED_INFORMATION gives us GetExitCodeProcess() and QueryFullProcessImageName() rights
+  //     even to elevated processes, meaning the below OR clause is unnecessary.
+  //
+  // (fullPath.empty() && ! wcscmp (pe32.szExeFile, app.second.launch_configs[0].executable.c_str()))
+  //
+
+  return ProcessMatch::None;
+}
+
+#pragma endregion
diff -ru skif.orig/src/stores/Steam/steam_library.cpp skif/src/stores/Steam/steam_library.cpp
--- skif.orig/src/stores/Steam/steam_library.cpp	2026-10-24 00:35:14.274395584 +0000
+++ skif/src/stores/Steam/steam_library.cpp	2026-10-24 00:36:40.436467637 +0000
@@ -2063,3 +2063,41 @@
 }
 
 #pragma endregion
+
+#pragma region Run State
+
+app_record_s::ProcessMatch
+app_record_steam_s::MatchProcess (const wchar_t* wszExeFile, const wchar_t* wszExePath, DWORD dwExePathLen)
+{
+  extern bool steamFallback; // tabs/library.cpp
+
+  UNREFERENCED_PARAMETER (wszExeFile);
+
+  if (dwExePathLen != 0 && _wcsnicmp (launch_configs[0].getExecutableFullPath ( ).c_str(), wszExePath, dwExePathLen) == 0)
+  {
+    // Only set the running state if the primary registry monitoring is unavailable
+    return (steamFallback) ? ProcessMatch::Running : ProcessMatch::PidOnly;
+  }
+
+  return ProcessMatch::None;
+}
+
+bool
+app_record_steam_s::KeepsRunningStateDuringScan (void) const
+{
+  extern bool steamRunning;  // tabs/library.cpp
+  extern bool steamFallback; // tabs/library.cpp
+
+  return (steamRunning || ! steamFallback);
+}
+
+bool
+app_record_steam_s::IsRunningStateFromClient (void) const
+{
+  extern bool steamRunning;  // tabs/library.cpp
+  extern bool steamFallback; // tabs/library.cpp
+
+  return (steamRunning && ! steamFallback);
+}
+
+#pragma endregion
diff -ru skif.orig/src/stores/Xbox/xbox_library.cpp skif/src/stores/Xbox/xbox_library.cpp
--- skif.orig/src/stores/Xbox/xbox_library.cpp	2026-10-24 00:35:14.274470683 +0000
+++ skif/src/stores/Xbox/xbox_library.cpp	2026-10-24 00:36:40.436836520 +0000
@@ -908,3 +908,18 @@
 }
 
 #pragma endregion
+
+#pragma region Run State
+
+// Workaround for Xbox games that run under the virtual folder, e.g. H:\Games\Xbox Games\Hades\Content\Hades.exe, by only checking the presence of the process name
+// TODO: Investigate if this is even really needed any longer? // Aemony, 2023-12-31
+app_record_s::ProcessMatch
+app_record_xbox_s::MatchProcess (const wchar_t* wszExeFile, const wchar_t* wszExePath, DWORD dwExePathLen)
+{
+  if (StrStrIW (launch_configs[0].getExecutableFileName ( ).c_str(), wszExeFile))
+    return ProcessMatch::Running;
+
+  return app_record_s::MatchProcess (wszExeFile, wszExePath, dwExePathLen);
+}
+
+#pragma endregion
